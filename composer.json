{
  "name": "jtlshop/semver",
  "description": "A decent, standards-compliant, Semantic Versioning (SemVer) parser and library",
  "keywords": [
    "semver",
    "semantic",
    "versioning"
  ],
  "homepage": "https://gitlab.jtl-software.de/jtlshop/semver",
  "time": "2025-09-22",
  "type": "library",
  "license": "MIT",
  "version": "2.1.0",
  "authors": [
    {
      "name": "Maurice Fonk",
      "email": "maurice@naneau.net",
      "homepage": "http://mauricefonk.com",
      "role": "developer"
    },
    {
      "name": "JTL-Software-GmbH",
      "email": "teamshop@jtl-software.com",
      "role": "developer"
    }
  ],
  "require": {
    "php": ">=8.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^4.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-0": {
      "JTLShop\\SemVer\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JTLShop\\SemVer\\Tests\\": "tests"
    }
  },
  "scripts": {
    "tests": "vendor/bin/phpunit",
    "test": "vendor/bin/phpunit",
    "phpcs": "vendor/bin/phpcs src tests",
    "sniff": "vendor/bin/phpcs src tests",
    "fix": "vendor/bin/phpcbf src tests",
    "phpcbf": "vendor/bin/phpcbf src tests",
    "phpstan": "vendor/bin/phpstan analyse src tests -l10"
  }
}
